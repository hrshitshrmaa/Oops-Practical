class Employee {
    String name;
    int salary;
    static int count = 0;
    Employee() {
        this("Unknown", 0);
    }
    Employee(String name, int salary) {
        this.name = name;
        this.salary = salary;
        count++;
    }
    void display() {
        System.out.println(name + " " + salary);
    }
    static void showCount() {
        System.out.println("Total Employees: " + count);
    }
}
public class Main {
    public static void main(String[] args) {
        Employee e1 = new Employee();
        Employee e2 = new Employee("Rahul", 20000);
        Employee e3 = new Employee("Aman", 30000);

        e1.display();
        e2.display();
        e3.display();

        Employee.showCount();
    }
}
